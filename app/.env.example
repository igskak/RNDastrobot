# ============================================================================
# Astrobot Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!
# ============================================================================

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://astrobot_user:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/astrobot_db
DB_HOST=YOUR_SUPABASE_HOST
DB_PORT=5432
DB_NAME=astrobot_db
DB_USER=astrobot_user
DB_PASSWORD=YOUR_PASSWORD

# Supabase Configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SERVICE_KEY
SUPABASE_JWT_AUDIENCE=authenticated

# Application Configuration
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here
SESSION_SECRET=replace-with-strong-random-value
SESSION_TTL_HOURS=168
COOKIE_DOMAIN=
COOKIE_SECURE=false
ENABLE_DEV_BOOTSTRAP=false
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8000

# Auth email verification / password reset
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_FROM=no-reply@your-domain.com

# Email provider: sendgrid | resend | smtp
EMAIL_PROVIDER=sendgrid

# SendGrid API provider (recommended for Render)
SENDGRID_API_KEY=SG_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_API_BASE=https://api.sendgrid.com

# Resend API provider
RESEND_API_KEY=
RESEND_API_BASE=https://api.resend.com

# SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Swiss Ephemeris Configuration
SWISSEPH_EPHE_PATH=./swisseph/ephe

# API Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/astrobot.log

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4.1
OPENAI_PROMPT_ID=your-prompt-id-here
OPENAI_PROMPT_VERSION=1.0
OPENAI_WORKFLOW_ID=wf_696ac18a25408190a38d8f44318c8c5a0b7269c5cba0bf81
OPENAI_PROGNOSTIC_WORKFLOW_ID=wf_6987cc5e9ff08190aeac925da8e921ea00c988f7d7727d42
