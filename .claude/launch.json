{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "steliara",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "PYTHONPATH=$(pwd) .venv/bin/uvicorn app.api.main:app --host 127.0.0.1 --port 8000"],
      "port": 8000
    },
    {
      "name": "aurora-demo",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "--directory", "app/frontend"],
      "port": 8777,
      "autoPort": true
    }
  ]
}
